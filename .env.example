# Lobby Seja AP — exemplo de configuração.
#
# Copie para `.env` na RAIZ do repositório: é o arquivo que o docker-compose lê
# (`env_file: .env`). Em produção ele vive em /opt/conecta/env/, modo 600, e
# nunca no repositório.
#
# Para rodar o backend fora do docker (testes, manage.py), o settings.py também
# aceita um `backend/.env`. Em produção quem manda é este, via compose.
#
# Sem NENHUMA destas variáveis o app sobe com SQLite e DEBUG ligado — o
# suficiente para rodar os testes e abrir o /django-admin/ local.

# === Núcleo ===
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-longo
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=lobby.sejaap.com.br,127.0.0.1
# Origens que podem enviar POST/PUT com cookie de sessão (o /django-admin/).
DJANGO_CSRF_TRUSTED_ORIGINS=https://lobby.sejaap.com.br

# === Banco ===
# Postgres `lobby` na db-sejaap (179.197.237.95), alcançado pelo container
# `db-tunnel` — a porta não é exposta na internet. 5437 é a próxima livre:
# 5433 kanban, 5434 CRM, 5435 formulários, 5436 identidade.
DATABASE_URL=postgresql://lobby_app:SENHA@db-tunnel:5437/lobby
DB_SSLMODE=require

# === Cache ===
# Sem isto o throttle da rota pública é por processo do gunicorn (3 workers) e
# zera a cada deploy. Ver o bloco CACHES em config/settings.py.
#
# Desde a TSK-1059 é também onde a asserção do Conecta guarda o `jti` contra
# repetição: SEM ELE, EM PRODUÇÃO, A INTEGRAÇÃO COM O CONECTA FICA DESLIGADA
# (503 INTEGRACAO_DESLIGADA). O resto do Lobby funciona igual.
#
# Decidido em 15/10/2026 (ADR-002 §13.2): o Redis do Conecta ID, que já roda
# nesta VPS, num ÍNDICE PRÓPRIO (o 3). O host é o do serviço Redis do Conecta ID
# (container `identidade-redis`). ATENÇÃO: hoje ele está só na rede fechada
# `identidade_interna` da stack do Conecta ID, que os apps não alcançam — ver
# "Integração com o Conecta" no deploy/RUNBOOK.md antes de preencher.
#
# Redis fora do ar não derruba o lobby: os tetos de chamada falham abertos; só a
# integração com o Conecta responde 503 até ele voltar.
# LOBBY_REDIS_URL=redis://identidade-redis:6379/3

# === Asserção do Conecta (TSK-1059, ADR-002 §13) ===
# O Admin Lobby do Conecta chama rotas de administração do Lobby em nome de uma
# pessoa, com um JWT Ed25519 curto no cabeçalho X-Conecta-Assercao. Aqui vai só a
# CHAVE PÚBLICA do Conecta, como conjunto JWK, uma entrada por `kid`. A chave
# PRIVADA nunca sai do servidor do Conecta e nunca vem para este arquivo.
#
# Vazio = integração DESLIGADA (503 nas rotas dela); o /admin de hoje e o login
# seguem iguais. Na troca de chave, as duas públicas ficam aqui juntas por uns
# minutos (ADR-002 §8.2). Um valor mal formado desliga a integração inteira, com
# ERROR no log da subida.
#
# Formato (em uma linha; o `x` é a chave pública crua em base64url, sem padding):
# CONECTA_ASSERCAO_CHAVES={"keys":[{"kty":"OKP","crv":"Ed25519","use":"sig","alg":"EdDSA","kid":"conecta-AAAAMM-a","x":"<chave pública>"}]}
CONECTA_ASSERCAO_CHAVES=
# Quem assina. A audiência NÃO se configura: é sempre "lobby".
CONECTA_ASSERCAO_EMISSOR=conecta
# Folga de relógio, em segundos (teto de 30 no código). Recusa por relógio se
# resolve no NTP, não aumentando isto.
CONECTA_ASSERCAO_TOLERANCIA_SEGUNDOS=10

# === n8n ===
# Segredo compartilhado com o fluxo do n8n, que o usa para chamar
# /api/venda/validar antes de processar uma venda. Precisa ser o MESMO valor nos
# dois lados. Gere com: openssl rand -hex 32
#
# Sem ele, /api/venda/validar responde 503 e o n8n cai no ramo de conferência
# manual — falha visível, nunca aceitação silenciosa.
# Ver deploy/N8N-VALIDACAO.md.
LOBBY_N8N_TOKEN=

# === Omie ===
# Credenciais do app no Omie, usadas SÓ para listar os departamentos
# (ListarDepartamentos) que o Elite e a APN pedem na etapa do cliente. Quem usa
# é o container `lobby-departamentos`, de hora em hora.
#
# A chave é do ERP inteiro — lê e escreve o financeiro. Fica só aqui, nunca no
# repositório e nunca no front. Sem ela, cada rodada loga a falha e o dropdown
# segue com a última lista que já está no banco.
#
# Cole a app_key exatamente como o Omie a mostra: um caractere a mais (um `#`
# copiado junto, por exemplo) e o Omie responde 403 "chave de acesso inválida".
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Segundos de espera pela resposta do Omie em cada rodada.
OMIE_TIMEOUT=20
# Categorias financeiras do campo Categoria da APN (TSK-879), pela mesma chave.
# Só entram as que ficam sob estes prefixos do plano de contas do Omie,
# separados por vírgula. 1.10 é o grupo "APN", com uma categoria por turma.
CATEGORIAS_FINANCEIRAS_PREFIXOS=1.10

# === Prometheus ===
# Token do /metrics, conferido com Bearer. VAZIO DESLIGA O ENDPOINT (404) — que
# é o padrão certo: aberto, ele entrega o volume de vendas da empresa e quantas
# pessoas podem autorizar desconto. Gere com: openssl rand -hex 32
#
# O mesmo valor vai em /opt/monitoring/prometheus/lobby_token na prod.solucoes.
# Ver deploy/monitoramento/prometheus-job-lobby.yml.
LOBBY_METRICS_TOKEN=

# === Limites ===
# Leitura do catálogo, por IP. É a primeira chamada de toda venda.
LOBBY_RATE_CATALOGO=240/hour
# Login, por IP. Note que a autorização de negociação é POR REGISTRO: o gerente
# digita a credencial a cada venda que destrava, e vários gerentes atrás do IP
# do escritório somam rápido. Apertar demais tranca o time no expediente.
LOBBY_RATE_LOGIN=120/hour
# Emissão de comprovante de venda.
LOBBY_RATE_COMPROVANTE=120/hour
# Lista de departamentos, por IP. O front reconsulta a cada 5 min, ao voltar
# para a aba e antes de enviar a venda.
LOBBY_RATE_DEPARTAMENTOS=600/hour
# Lista de categorias financeiras da APN (TSK-877), por IP. Mesmo ritmo da de
# departamentos.
LOBBY_RATE_CATEGORIAS_FINANCEIRAS=600/hour
# Valores das modalidades do DH - Avaliação (TSK-1056), por IP. Mesmo ritmo da
# lista de departamentos.
LOBBY_RATE_DH_AVALIACAO=600/hour
# Integração com o Conecta (TSK-1059), POR PESSOA: toda chamada sai do IP do
# servidor do Conecta, então teto por IP limitaria o portal inteiro de uma vez.
LOBBY_RATE_INTEGRACAO_LEITURA=120/min
LOBBY_RATE_INTEGRACAO_ESCRITA=30/min
# Recusas de asserção (antes de haver pessoa), por IP.
LOBBY_RATE_INTEGRACAO_FALHAS=60/min

# === Sessão ===
# Validade do JWT do /admin, em minutos. 480 = 8h, igual ao token que o
# Cloudflare Functions emitia antes da migração.
LOBBY_JWT_MINUTOS=480

# === HTTPS ===
# Quem termina o TLS é a Cloudflare; o gunicorn recebe HTTP na rede do docker e
# reconhece o esquema pelo X-Forwarded-Proto. Deixe o redirect ligado e mande o
# header no healthcheck — é o que o Formulários Financeiro faz.
SECURE_SSL_REDIRECT=true

# === Log ===
LOBBY_LOG_LEVEL=INFO

# === Conecta ID ===
# Quem guarda senha é o Conecta ID; este app não tem senha local nenhuma.
#
# ATENÇÃO: AUTH_CENTRAL_ATIVO=false NÃO é rollback, é TRANCA. Sem ele ninguém
# entra — nem superusuário — porque não existe senha local para cair de volta.
#
# A chave sai de `manage.py cadastrar_aplicacao lobby --emitir-chave` no
# container do Conecta ID, e aparece UMA única vez. Sem --gestao: o Lobby não
# deve enxergar a base inteira de identidades da empresa.
AUTH_CENTRAL_ATIVO=true
IDENTIDADE_URL=http://identidade-api:8000
IDENTIDADE_APP_KEY=AppKey lobby:SEGREDO
IDENTIDADE_TIMEOUT=5

# Primeira pessoa da diretoria (o ovo e a galinha: sem login local, ninguém
# alcança o /django-admin/ para se promover):
#   docker exec lobby-backend python manage.py promover_no_lobby \
#       fulano@sejaap.com.br --papel diretoria
